{
  "name": "tamanna-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Tamanna AI project tools and static web frontend",
  "author": "HM INSAN ALI",
  "type": "commonjs",
  "scripts": {
    "dev": "node scripts/serve-static.js .",
    "build": "node scripts/build-static.js",
    "start": "node scripts/serve-static.js dist",
    "check": "node scripts/npm-build-check.js",
    "check:cloudflare": "npm run build && node scripts/verify-cloudflare-deploy.js",
    "deploy": "npx wrangler deploy --config ./wrangler.jsonc",
    "preview": "npx wrangler dev --config ./wrangler.jsonc",
    "deploy:cloudflare": "npm run check:cloudflare && npm run deploy",
    "test": "node --test",
    "audit:domain": "bash scripts/domain-audit.sh"
  },
  "engines": {
    "node": ">=20"
  }
}