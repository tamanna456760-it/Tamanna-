  "learning_paths": [
    {
      "level": 1,
      "id": "programming_mastery",
      "title": "Programming Mastery",
      "goal": "Build strong software-engineering foundations before moving into AI model internals.",
      "topics": [
        "Python",
        "Data Structures",
        "Algorithms",
        "Object-Oriented Programming (OOP)",
        "Linux",
        "Git"
      ],
      "recommended_order": [
        "Python fundamentals and standard library",
        "Data structures: arrays/lists, stacks, queues, hash maps, trees, graphs",
        "Algorithms: searching, sorting, recursion, complexity and Big-O",
        "OOP: classes, objects, encapsulation, inheritance and composition",
        "Linux: shell, files, permissions, processes and networking basics",
        "Git: commits, branches, merges, pull requests and conflict resolution"
      ],
      "resources": [
        {
          "id": "roadmap_python",
          "name": "roadmap.sh Python Roadmap",
          "url": "https://roadmap.sh/python"
        },
        {
          "id": "roadmap_backend",
          "name": "roadmap.sh Backend Roadmap",
          "url": "https://roadmap.sh/backend"
        }
      ],
      "completion_project": "Build a Python CLI application with modular OOP design, tests, Git history, and Linux run instructions."
    },
    {
      "level": 2,
      "id": "how_ai_understands_text",
      "title": "How AI Understands Text",
      "goal": "Understand the mathematical and architectural foundations behind modern language models.",
      "topics": [
        "Neural Networks",
        "Deep Learning",
        "Embeddings",
        "Transformers",
        "Attention Mechanism"
      ],
      "recommended_order": [
        "Neural-network basics: tensors, layers, weights, activations and loss",
        "Deep-learning training: forward pass, backpropagation, gradient descent and evaluation",
        "Embeddings: vector representations, similarity and semantic search",
        "Attention: queries, keys, values and scaled dot-product attention",
        "Transformers: tokenization, positional information, encoder/decoder patterns and model training/inference"
      ],
      "resources": [
        {
          "id": "deeplearning_ai",
          "name": "DeepLearning.AI",
          "url": "https://www.deeplearning.ai/"
        },
        {
          "id": "huggingface_learn",
          "name": "Hugging Face Learn",
          "url": "https://huggingface.co/learn"
        },
        {
          "id": "pytorch_tutorials",
          "name": "PyTorch Tutorials",
          "url": "https://pytorch.org/tutorials/"
        }
      ],
      "completion_project": "Create a small text-embedding search demo, then implement or inspect a simple attention/Transformer example in PyTorch."
    },
    {
      "level": 3,
      "id": "llm_engineering_and_agent_systems",
      "title": "LLM Engineering and AI Agent Systems",
      "goal": "Learn to integrate language models, run suitable open-weight models locally, build retrieval systems, and design reliable tool-using and multi-agent applications.",
      "topics": [
        "LLM APIs and model serving",
        "Hugging Face model hubs and model cards",
        "Local inference with Llama, Qwen, DeepSeek, Mistral and Phi model families",
        "Transformer architecture and the Attention Is All You Need paper",
        "Retrieval-Augmented Generation (RAG)",
        "Agent systems and tool calling",
        "Knowledge Graphs",
        "Multi-Agent AI"
      ],
      "recommended_order": [
        "Read Hugging Face and OpenAI platform documentation; learn model loading, tokenization, inference, API usage and tool calling.",
        "Compare model cards, licenses, context limits, benchmarks, quantization options and hardware requirements before selecting a local model.",
        "Study the Transformer architecture and the Attention Is All You Need paper; trace tokenization, embeddings, attention, positional encoding and generation.",
        "Build a basic RAG pipeline: document ingestion, chunking, embeddings, vector retrieval, grounded generation and source citations.",
        "Build a constrained agent with an explicit tool registry, input validation, permission checks, timeouts, logging and human approval for risky actions.",
        "Study Knowledge Graphs and connect entities/relationships to retrieval where structured relationships improve answers.",
        "Experiment with Multi-Agent AI using narrow roles, explicit message schemas, bounded handoffs, shared task state and loop limits.",
        "Evaluate quality, latency, cost, retrieval accuracy, tool success and safety before integrating components into Tamanna AI."
      ],
