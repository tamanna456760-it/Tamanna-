# Tamanna AI Environment Configuration

# System
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# GitHub
GITHUB_USERNAME=your_username
GITHUB_TOKEN=your_token_here
GITHUB_REPO=Tamanna-

# Database
DATABASE_URL=postgresql://tamanna:password@localhost:5432/tamanna_ai

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# AI Settings
AI_ENABLE_AUTO_FIX=true
AI_ENABLE_AUTO_SYNC=true
AI_SCAN_INTERVAL_SECONDS=300

# Backup Settings
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30

# Security
SECRET_KEY=your_secret_key_here
ALLOWED_HOSTS=localhost,127.0.0.1
