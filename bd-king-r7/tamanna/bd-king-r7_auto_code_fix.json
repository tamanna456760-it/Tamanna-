{
  "project_name": "BD-King-R7 AI System",
  "version": "1.0.0",
  "description": "Auto-code fixing and synchronization system",
  "author": "BD-King-R7 AI",
  "config": {
    "auto_fix": true,
    "auto_sync": true,
    "backup_enabled": true,
    "real_time_monitoring": true,
    "code_quality_threshold": 85,
    "security_scan": true
  },
  "file_patterns": {
    "include": [
      "**/*.py",
      "**/*.js",
      "**/*.html",
      "**/*.css",
      "**/*.json",
      "**/*.md"
    ],
    "exclude": [
      "node_modules/**",
      "venv/**",
      ".git/**",
      "**/__pycache__/**"
    ]
  },
  "code_rules": {
    "python": {
      "max_line_length": 100,
      "require_docstrings": true,
      "enforce_type_hints": true,
      "import_order": "standard"
    },
    "javascript": {
      "semicolons": true,
      "quotes": "single",
      "indent_size": 2
    },
    "html": {
      "indent_size": 2,
      "self_closing_tags": true
    },
    "css": {
      "indent_size": 2,
      "color_format": "hex"
    }
  },
  "auto_fix_rules": {
    "remove_unused_imports": true,
    "fix_indentation": true,
    "add_missing_imports": true,
    "fix_code_formatting": true,
    "optimize_performance": true,
    "security_enhancements": true
  },
  "sync_config": {
    "target_directories": [
      "./src",
      "./config",
      "./scripts"
    ],
    "sync_interval": 5000,
    "conflict_resolution": "smart",
    "backup_strategy": "incremental"
  },
  "ai_assistance": {
    "code_completion": true,
    "bug_detection": true,
    "performance_suggestions": true,
    "security_recommendations": true
  }
}