<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Tamanna.png</title>
  <style>
    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      background: #f6f7fb;
      font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial;
    }
    figure { text-align: center; margin: 0; }
    img {
      max-width: 90vw;
      max-height: 80vh;
      border-radius: 12px;
      border: 3px solid #d7d9e4;
      box-shadow: 0 12px 30px rgba(0,0,0,0.12);
    }
    figcaption { margin-top: 10px; color: #555; }
  </style>
</head>
<body>
  <figure>
    <img src="tamanna.png" alt="Tamanna image">
    <figcaption>Tamanna.png</figcaption>
  </figure>
</body>
</html>
