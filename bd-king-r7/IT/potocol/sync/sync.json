{
  "system": {
    "name": "bd-king-r7 PowerHub Sync",
    "version": "7.0.0",
    "mode": "automatic",
    "enabled": true
  },
  "repository": {
    "auto_pull": true,
    "auto_commit": true,
    "auto_push": true,
    "branch": "main",
    "verify_integrity": true
  },
  "monitoring": {
    "enabled": true,
    "service_health_check": true,
    "resource_monitoring": true,
    "log_analysis": true,
    "uptime_tracking": true
  },
  "file_integrity": {
    "enabled": true,
    "check_missing_files": true,
    "check_modified_files": true,
    "verify_checksums": true
  },
  "backup": {
    "enabled": true,
    "verify_backups": true,
    "retention_days": 30
  },
  "deployment": {
    "validate_build": true,
    "validate_dependencies": true,
    "validate_configuration": true
  },
  "security": {
    "audit_enabled": true,
    "check_updates": true,
    "review_permissions": true,
    "review_exposed_services": true
  },
  "reports": {
    "generate_health_score": true,
    "generate_summary": true,
    "generate_recommendations": true
  }
}