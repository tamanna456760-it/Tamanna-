{
  "architecture": {
    "sequence_length": 50,
    "num_features": 15,
    "num_classes": 8,
    "rnn_type": "lstm",
    "rnn_layers": [
      { "units": 128, "return_sequences": true },
      { "units": 64, "return_sequences": true },
      { "units": 32, "return_sequences": false }
    ],
    "dense_layers": [64, 32],
    "dropout_rate": 0.3,
    "recurrent_dropout": 0.2,
    "bidirectional": true,
    "layer_normalization": true
  },
  "training": {
    "batch_size": 32,
    "epochs": 150,
    "learning_rate": 0.001,
    "optimizer": "adam",
    "loss": "categorical_crossentropy",
    "metrics": ["accuracy", "auc"],
    "early_stopping": true,
    "patience": 20,
    "shuffle_sequences": false
  },
  "sequence_processing": {
    "padding": "pre",
    "truncating": "pre",
    "max_sequence_length": 100,
    "feature_scaling": true
  }
}
