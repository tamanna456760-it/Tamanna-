{
  "monitoring_config": {
    "performance_metrics": {
      "tracking_interval": "5m",
      "alert_thresholds": {
        "accuracy_drop": 0.05,
        "latency_increase": 0.2,
        "error_rate": 0.01
      }
    },
    "data_drift": {
      "monitoring_enabled": true,
      "drift_threshold": 0.1,
      "features_monitored": ["all"]
    },
    "model_bias": {
      "fairness_metrics": ["demographic_parity", "equal_opportunity"],
      "bias_threshold": 0.05
    }
  }
}