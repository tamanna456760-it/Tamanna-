{
  "base_learning_rate": 0.001,
  "initial_exploration_rate": 0.1,
  "min_exploration_rate": 0.01,
  "experience_replay_size": 10000,
  "batch_size": 32,
  "learning_cycles_per_day": 24,
  "performance_threshold": 0.85,
  "adaptation_threshold": 0.1,
  "knowledge_retention_days": 90,
  "learning_modes": {
    "supervised": {
      "enabled": true,
      "min_samples": 10,
      "validation_split": 0.2
    },
    "unsupervised": {
      "enabled": true,
      "clustering_enabled": true,
      "anomaly_detection_enabled": true
    },
    "reinforcement": {
      "enabled": true,
      "q_learning": true,
      "policy_gradient": true,
      "reward_shaping": true
    },
    "transfer_learning": {
      "enabled": true,
      "domains": ["transactions", "inventory", "customers", "security"]
    },
    "meta_learning": {
      "enabled": true,
      "adaptation_rate": 0.01,
      "analysis_frequency": "daily"
    }
  },
  "knowledge_management": {
    "max_knowledge_units": 10000,
    "confidence_decay": 0.99,
    "consolidation_frequency": "weekly",
    "pruning_enabled": true
  },
  "performance_tracking": {
    "metrics": ["accuracy", "precision", "recall", "f1_score", "learning_gain"],
    "tracking_frequency": "hourly",
    "alerting_enabled": true
  }
}