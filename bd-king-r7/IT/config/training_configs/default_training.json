{
  "training_id": "default_training",
  "description": "Default training configuration for TI-PULS models",
  "data_preprocessing": {
    "handle_missing_values": true,
    "normalize_features": true,
    "encode_categorical": true,
    "feature_selection": true,
    "data_augmentation": true
  },
  "training_parameters": {
    "batch_size": 32,
    "epochs": 100,
    "learning_rate": 0.001,
    "validation_split": 0.2,
    "early_stopping_patience": 10,
    "model_checkpointing": true
  },
  "evaluation_metrics": [
    "accuracy",
    "precision",
    "recall",
    "f1_score",
    "auc_roc",
    "confusion_matrix"
  ],
  "hyperparameter_tuning": {
    "enabled": true,
    "method": "bayesian",
    "parameters": {
      "learning_rate": [0.0001, 0.001, 0.01],
      "batch_size": [16, 32, 64],
      "hidden_units": [64, 128, 256]
    },
    "max_trials": 20
  },
  "output_config": {
    "save_format": "tensorflow_savedmodel",
    "include_preprocessing": true,
    "generate_documentation": true,
    "performance_report": true
  }
}
