{
  "encryption": {
    "algorithm": "AES-256-GCM",
    "key_rotation_days": 30,
    "master_key_derivation_iterations": 100000,
    "sensitive_data_encryption": "AES-256-GCM",
    "standard_data_encryption": "AES-256-CBC"
  },
  "authentication": {
    "multi_factor": true,
    "session_timeout": 3600,
    "max_login_attempts": 5,
    "lockout_duration": 900,
    "password_policy": {
      "min_length": 12,
      "require_uppercase": true,
      "require_lowercase": true,
      "require_numbers": true,
      "require_special": true,
      "max_age_days": 90
    },
    "biometric_enabled": false
  },
  "network_security": {
    "firewall_enabled": true,
    "intrusion_detection": true,
    "port_scan_protection": true,
    "allowed_ports": [22, 80, 443, 8000, 9000],
    "blocked_countries": ["CN", "RU", "KP", "IR"],
    "vpn_required": false,
    "network_segmentation": true
  },
  "monitoring": {
    "real_time_scanning": true,
    "file_integrity_monitoring": true,
    "process_monitoring": true,
    "network_traffic_analysis": true,
    "user_activity_monitoring": true,
    "log_analysis": true,
    "update_interval_seconds": 5
  },
  "threat_response": {
    "auto_block_ips": true,
    "auto_isolate_systems": true,
    "immediate_alerts": true,
    "emergency_lockdown": true,
    "incident_response_automation": true,
    "forensic_data_collection": true
  },
  "compliance": {
    "gdpr_enabled": true,
    "hipaa_enabled": false,
    "pci_dss_enabled": true,
    "sox_enabled": false
  },
  "threat_intelligence": {
    "external_feeds": true,
    "update_frequency_hours": 1,
    "auto_block_known_threats": true,
    "threat_sharing": true
  },
  "backup_recovery": {
    "encrypted_backups": true,
    "backup_frequency_hours": 24,
    "retention_days": 90,
    "disaster_recovery_enabled": true
  }
}
