# ক্যালকুলেটর প্রোগ্রাম
লেখো "উন্নত ক্যালকুলেটর"

কাজ যোগ(a, b):
    ফেরত a + b

কাজ বিয়োগ(a, b):
    ফেরত a - b

কাজ গুণ(a, b):
    ফেরত a * b

কাজ ভাগ(a, b):
    যদি b == 0:
        লেখো "শূন্য দিয়ে ভাগ করা যায় না!"
        ফেরত 0
    নাহলে:
        ফেরত a / b

# মূল প্রোগ্রাম
নির্ধারণ x = 20
নির্ধারণ y = 4

লেখো "x = " + x + ", y = " + y
লেখো "যোগ: " + যোগ(x, y)
লেখো "বিয়োগ: " + বিয়োগ(x, y)
লেখো "গুণ: " + গুণ(x, y)
লেখো "ভাগ: " + ভাগ(x, y)
লেখো "ক্যালকুলেটর প্রোগ্রাম"

নির্ধারণ a = 20
নির্ধারণ b = 4

লেখো a + b
লেখো a - b  
লেখো a * b
লেখো a / b

যদি a > b:
    লেখো "a বড়"
নাহলে:
    লেখো "b বড়"