# নেটওয়ার্ক ডেমো
লেখো "নেটওয়ার্ক সিস্টেম শুরু হচ্ছে..."

নির্ধারণ port = 8080
নির্ধারণ host = "localhost"

লেখো "পোর্ট: " + port
লেখো "হোস্ট: " + host

# সার্ভার তৈরি
নেটওয়ার্ক সার্ভার port
লেখো "সার্ভার তৈরি হয়েছে পোর্ট " + port + " এ"

# ক্লায়েন্ট কানেকশন
কানেক্ট host port
লেখো "কানেক্ট হয়েছে " + host + ":" + port + " এ"

# মেসেজ সেন্ড
সেন্ড "হ্যালো সার্ভার!"
লেখো "মেসেজ সেন্ড করা হয়েছে"

# রিস্পন্স রিসিভ
নির্ধারণ response = রিসিভ
লেখো "রিসিভ করা হয়েছে: " + response