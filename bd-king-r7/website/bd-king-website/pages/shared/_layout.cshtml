@*
    ============================================================
    BD-KING-R7 / TAMANNA AI
    Powerhub — Shared Razor Layout
    Owner: HM INSAN ALI

    Purpose:
    - Global website layout
    - Navigation
    - Responsive structure
    - Accessibility
    - Global metadata
    - Razor Page rendering
    ============================================================
*@

<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <meta name="description"
          content="BD-KING-R7 Powerhub — Tamanna AI documentation, automation, development systems and project information." />

    <meta name="application-name"
          content="Tamanna AI" />

    <meta name="author"
          content="HM INSAN ALI" />

    <meta name="theme-color"
          content="#0b0f14" />

    <title>
        @(ViewData["Title"] ?? "Tamanna AI — BD-KING-R7 Powerhub")
    </title>

    <!-- Main stylesheet -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)

</head>

<body>

    <!-- ======================================================
         SITE HEADER
         ====================================================== -->

    <header class="site-header">

        <div class="container site-header-inner">

            <!-- Brand -->

            <div class="site-brand">

                <a asp-page="/Index"
                   class="site-brand-link"
                   aria-label="Tamanna AI BD-KING-R7 Powerhub Home">

                    <span class="site-brand-project">
                        BD-KING-R7
                    </span>

                    <span class="site-brand-name">
                        Powerhub
                    </span>

                </a>

            </div>


            <!-- Navigation -->

            <nav class="site-nav"
                 aria-label="Primary navigation">

                <a asp-page="/Index">
                    Home
                </a>

                <a asp-page="/TamannaAI">
                    Tamanna AI
                </a>

                <a asp-page="/ProgramSystem">
                    Program &amp; System
                </a>

                <a asp-page="/CodeLanguages">
                    Code Languages
                </a>

            </nav>

        </div>

    </header>


    <!-- ======================================================
         MAIN CONTENT
         ====================================================== -->

    <main id="main-content"
          class="container site-main">

        @RenderBody()

    </main>


    <!-- ======================================================
         FOOTER
         ====================================================== -->

    <footer class="site-footer">

        <div class="container site-footer-inner">

            <div class="footer-brand">

                <strong>
                    Tamanna AI
                </strong>

                <span>
                    BD-KING-R7 Powerhub
                </span>

            </div>


            <div class="footer-info">

                <span>
                    Owner: HM INSAN ALI
                </span>

                <span>
                    .NET 8 • Razor Pages
                </span>

            </div>


            <div class="footer-copy">

                <span>
                    © @DateTime.UtcNow.Year BD-KING-R7
                </span>

                <span>
                    Powerhub documentation system
                </span>

            </div>

        </div>

    </footer>


    <!-- ======================================================
         GLOBAL SCRIPTS
         ====================================================== -->

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>