# Trusted browser origins, comma-separated
TAMANNA_CORS_ORIGINS=https://www.tamanna.com,https://tamanna.com

# Gemini credentials: set only in the server's private .env file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Required for privileged shell, command, repair and file-write APIs.
# Generate a long random value on the server; never commit the real value.
TAMANNA_ADMIN_API_KEY=

# Runtime
TAMANNA_ENV=production
TAMANNA_GEMINI_CHAT=1
HOST=0.0.0.0
PORT=8000
