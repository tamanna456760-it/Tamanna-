

# Comma-separated trusted frontend origins
TAMANNA_CORS_ORIGINS=https://www.bd-king-r7.com,https://bd-king-r7.com

# Gemini key belongs in the local, untracked .env file.
# Never commit a real API key.
GEMINI_API_KEY=

# Tamanna AI authentication (generate a unique secret; never commit your real .env)
TAMANNA_SESSION_SECRET=
TAMANNA_SESSION_SECONDS=604800
TAMANNA_COOKIE_SECURE=1
TAMANNA_AUTH_DB=data/accounts.sqlite3

# Admin account for privileged server/code operations (set to your account email).
# Leave empty to keep privileged operations disabled until configured.
TAMANNA_ADMIN_EMAIL=

# AI model provider (keep real keys only in private .env)
TAMANNA_MODEL_PROVIDER=gemini
TAMANNA_MODEL_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional allow-listed web search provider
TAMANNA_SEARCH_PROVIDER=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# SQLAlchemy chat storage (default: data/tamanna.sqlite3)
TAMANNA_DATABASE_URL=
TAMANNA_MAX_REQUEST_BYTES=1048576
