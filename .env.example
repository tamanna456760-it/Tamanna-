
# Tamanna AI - Example configuration
# Copy to .env locally and enter your own values.
# Never commit real API keys or passwords.

HOST=127.0.0.1
PORT=8000
RELOAD=0

# Google Gemini: add your own key locally when Gemini integration is configured.
GEMINI_API_KEY=

# Optional persistent memory file
TAMANNA_MEMORY_FILE=data/tamanna_memory.json

# Keep debug features disabled by default.
DEBUG=0
