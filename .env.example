# Tamanna AI private environment template
# Copy this file to .env, then replace the placeholders locally.
# NEVER commit .env or real credentials.

TAMANNA_ENV=production
HOST=0.0.0.0
PORT=8000

# Select one provider: ollama (local, default) or openai (hosted API).
TAMANNA_MODEL_PROVIDER=ollama
TAMANNA_OLLAMA_URL=http://127.0.0.1:11434
TAMANNA_OLLAMA_MODEL=qwen2.5:7b

# OpenAI provider: keep this key only in the server's private .env/secret store.
# To enable GPT, set TAMANNA_MODEL_PROVIDER=openai and provide OPENAI_API_KEY.
# TAMANNA_MODEL_PROVIDER=openai
OPENAI_API_KEY=
TAMANNA_OPENAI_MODEL=gpt-5.5
TAMANNA_OPENAI_BASE_URL=https://api.openai.com/v1

# Test-only provider; never use mock for real users.
# TAMANNA_MODEL_PROVIDER=mock (requires TAMANNA_ENV=test)

# Authentication. Generate at least 32 random bytes:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
TAMANNA_SESSION_SECRET=
TAMANNA_SESSION_SECONDS=604800
TAMANNA_COOKIE_SECURE=1
TAMANNA_AUTH_DB=data/accounts.sqlite3
TAMANNA_ADMIN_EMAIL=Tamanna456760@gmail.com

# Optional Google Identity Services sign-in (public OAuth Web Client ID, not a secret).
GOOGLE_CLIENT_ID=

# Database. SQLite is the default and works without an external database.
TAMANNA_DATABASE_URL=sqlite:///data/tamanna.sqlite3

# Browser security. Add only exact trusted origins, comma-separated.
TAMANNA_CORS_ORIGINS=https://www.bd-king-r7.com

# Request limit
TAMANNA_MAX_REQUEST_BYTES=1048576

# Optional web search providers
TAMANNA_SEARCH_PROVIDER=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# Optional Tamanna Central Server connection.
TAMANNA_SERVER_URL=http://127.0.0.1:8000
TAMANNA_SERVER_KEY_ID=tamanna-ai
TAMANNA_SERVER_SHARED_SECRET=
