# Tamanna AI IDS - Example Environment Configuration
# Owner: HM INSAN ALI
# Never place real secrets in this file.
TAMANNA_IDS_ENABLED=true
TAMANNA_IDS_MODE=monitor_only
# Detection thresholds
TAMANNA_IDS_FAILED_LOGIN_THRESHOLD=5
TAMANNA_IDS_FAILED_LOGIN_WINDOW=300
TAMANNA_IDS_REQUEST_RATE_THRESHOLD=60
TAMANNA_IDS_REQUEST_RATE_WINDOW=60
# Event collection
TAMANNA_IDS_MAX_EVENT_SIZE=16384
TAMANNA_IDS_MAX_IN_MEMORY_EVENTS=1000
TAMANNA_IDS_REDACT_SECRETS=true
# Safety: monitoring only; no automatic enforcement
TAMANNA_IDS_AUTOMATIC_IP_BLOCKING=false
TAMANNA_IDS_MODIFY_SYSTEM_FIREWALL=false
TAMANNA_IDS_MANUAL_APPROVAL=true