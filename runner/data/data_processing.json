{
  "id": "data_processing_pipeline",
  "name": "Data Processing Pipeline",
  "version": "1.0.0",
  "description": "Automated data processing and analysis pipeline",
  "triggers": [
    {
      "type": "schedule",
      "schedule": {
        "cron": "0 2 * * *",
        "timezone": "UTC"
      }
    },
    {
      "type": "event",
      "event_type": "data_received",
      "conditions": [
        {
          "field": "data_size",
          "operator": "greater_than",
          "value": 1000
        }
      ]
    }
  ],
  "variables": {
    "input_path": "/data/input/",
    "output_path": "/data/output/",
    "temp_path": "/data/temp/"
  },
  "tasks": [
    {
      "id": "validate_input",
      "name": "Validate Input Data",
      "type": "data_processing",
      "parameters": {
        "operation": "validate",
        "source": "${input_path}",
        "rules": ["format_check", "size_check", "integrity_check"]
      }
    },
    {
      "id": "transform_data",
      "name": "Transform Data",
      "type": "data_processing",
      "parameters": {
        "operation": "transform",
        "source": "${validate_input.output}",
        "transformations": ["clean", "normalize", "enrich"]
      },
      "dependencies": ["validate_input"]
    },
    {
      "id": "analyze_data",
      "name": "Analyze Data",
      "type": "data_processing",
      "parameters": {
        "operation": "analyze",
        "source": "${transform_data.output}",
        "analytics": ["trends", "patterns", "anomalies"]
      },
      "dependencies": ["transform_data"]
    },
    {
      "id": "generate_report",
      "name": "Generate Analytics Report",
      "type": "report_generation",
      "parameters": {
        "report_type": "analytics",
        "data": "${analyze_data.output}",
        "output_path": "${output_path}"
      },
      "dependencies": ["analyze_data"]
    },
    {
      "id": "notify_team",
      "name": "Notify Team",
      "type": "notification_send",
      "parameters": {
        "message": "Data processing completed successfully",
        "channel": "email",
        "recipients": ["team@company.com"]
      },
      "dependencies": ["generate_report"]
    }
  ],
  "error_handling": {
    "strategy": "retry",
    "max_retries": 3,
    "fallback_action": "notify_admin",
    "escalation_timeout": 3600
  }
}
