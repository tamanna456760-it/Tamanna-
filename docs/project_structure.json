{
  "project_name": "Tamanna AI",
  "version": "7.0",
  "auto_scan": true,
  "auto_sync": true,
  "auto_fix": true,
  "directories": {
    "src": {
      "core": [
        "syncengine.py",
        "monitoring_system.py"
      ]
    },
    "bd-king-r7": {
      "server": [
        "server.js",
        "chat.js",
        "style.css",
        "update.html",
        "index.html",
        "package.json"
      ]
    },
    "tamanna": [
      "auto_fixar.py",
      "multilingual.py",
      "bd-king-r7_auto_code_fix.json"
    ],
    "IT": {
      "core": [
        "ai_engine.py",
        "learning_system.py",
        "decision_maker.py",
        "data_processor.py"
      ],
      "database": [
        "schema.sql"
      ],
      "Cybersecurity": [
        "cybersecurity.py",
        "network_defence.py",
        "security_hardening.sh"
      ],
      "website": {
        "backend": [
          "server.js",
          "package.json"
        ],
        "frontend": [
          "package.json",
          "vite.config.js",
          "index.html"
        ]
      }
    }
  },
  "services": {
    "ai_engine": {
      "enabled": true,
      "entry": "IT/core/ai_engine.py"
    },
    "monitoring": {
      "enabled": true,
      "entry": "IT/system_monitor/system_monitor.py"
    },
    "website": {
      "enabled": true,
      "frontend": "IT/website/frontend",
      "backend": "IT/website/backend"
    }
  },
  "startup": {
    "python": [
      "IT/core/ai_engine.py",
      "IT/system_monitor/system_monitor.py"
    ],
    "nodejs": [
      "bd-king-r7/server/server.js",
      "IT/website/backend/server.js"
    ]
  },
  "logging": {
    "enabled": true,
    "log_level": "INFO",
    "log_file": "logs/system.log"
  },
  "backup": {
    "enabled": true,
    "path": "backup/",
    "interval_hours": 24
  }
}