{

  "github.copilot.enable": {
    "*": true,
    "plaintext": false
  },

  "editor.codeActionsOnSave": {
    "source.fixAll": true,
    "source.organizeImports": true
  },

  "extensions.autoUpdate": true,

  "github.copilot.updateCheck": true,
  

  "github.copilot.advanced": {
    "inlineSuggestCount": 5,
    "enableAutoCompletions": true
  }
}
