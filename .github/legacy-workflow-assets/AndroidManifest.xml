name: Ultimate MDM Blocker APK Builder

on:
  push:
    branches: [ main, develop ]
    paths:
      - 'app/**'
      - 'gradle/**'
      - '*.gradle'
      - '*.properties'
  pull_request:
    branches: [ main ]
  workflow_dispatch:
    inputs:
      variant:
        description: 'Build variant (debug/release/both)'
        required: true
        default: 'both'
        type: choice
        options:
          - debug
          - release
          - both

env:
  JAVA_VERSION: '17'
  GRADLE_OPTS: '-Dorg.gradle.jvmargs=-Xmx4g -Dorg.gradle.daemon=false'

jobs:
  build:
    name: Build MDM Blocker APK
    runs-on: ubuntu-latest
    strategy:
      matrix:
        variant: ${{ fromJSON(github.event.inputs.variant == 'both' && '["debug","release"]' || (github.event.inputs.variant == 'debug' && '["debug"]' || '["release"]')) }}
      fail-fast: false

    steps:
      # 1. Checkout code with full history (for versioning)
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      # 2. Setup JDK
      - name: Set up JDK ${{ env.JAVA_VERSION }}
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: ${{ env.JAVA_VERSION }}
          cache: 'gradle'

      # 3. Setup Android SDK (cached)
      - name: Setup Android SDK
        uses: android-actions/setup-android@v3
        with:
          cmdline-tools-version: 9477386
          packages: >-
            platform-tools
            platforms;android-34
            build-tools;34.0.0

      # 4. Cache Gradle and Android build caches
      - name: Cache Gradle
        uses: actions/cache@v4
        with:
          path: |
            ~/.gradle/caches
            ~/.gradle/wrapper
          key: ${{ runner.os }}-gradle-${{ hashFiles('**/*.gradle*', '**/gradle-wrapper.properties') }}
          restore-keys: |
            ${{ runner.os }}-gradle-

      - name: Cache Android SDK
        uses: actions/cache@v4
        with:
          path: /usr/local/lib/android/sdk
          key: ${{ runner.os }}-android-sdk-${{ hashFiles('**/build.gradle') }}
          restore-keys: ${{ runner.os }}-android-sdk-

      # 5. Grant execute permission for gradlew
      - name: Make gradlew executable
        run: chmod +x gradlew

      # 6. Build the APK (debug or release)
      - name: Build ${{ matrix.variant }} APK
        run: ./gradlew assemble${{ matrix.variant == 'debug' && 'Debug' || 'Release' }} --stacktrace

      # 7. Sign release APK (if release variant and secrets exist)
      - name: Sign release APK
        if: matrix.variant == 'release' && env.KEYSTORE_BASE64 != ''
        env:
          KEYSTORE_BASE64: ${{ secrets.KEYSTORE_BASE64 }}
          KEYSTORE_PASSWORD: ${{ secrets.KEYSTORE_PASSWORD }}
          KEY_ALIAS: ${{ secrets.KEY_ALIAS }}
          KEY_PASSWORD: ${{ secrets.KEY_PASSWORD }}
        run: |
          echo "$KEYSTORE_BASE64" | base64 -d > keystore.jks
          jarsigner -verbose -sigalg SHA1withRSA -digestalg SHA1 -keystore keystore.jks -storepass "$KEYSTORE_PASSWORD" -keypass "$KEY_PASSWORD" app/build/outputs/apk/release/*.apk "$KEY_ALIAS"
          # Verify
          jarsigner -verify -verbose -certs app/build/outputs/apk/release/*.apk

      # 8. Upload APK as workflow artifact
      - name: Upload ${{ matrix.variant }} APK artifact
        uses: actions/upload-artifact@v4
        with:
          name: mdm-blocker-${{ matrix.variant }}-${{ github.run_number }}
          path: app/build/outputs/apk/${{ matrix.variant }}/*.apk
          retention-days: 30

      # 9. (Optional) Create GitHub Release and upload APK (only on main branch push)
      - name: Create Release and upload APK
        if: github.event_name == 'push' && github.ref == 'refs/heads/main' && matrix.variant == 'release'
        uses: softprops/action-gh-release@v2
        with:
          tag_name: v${{ github.run_number }}
          name: MDM Blocker Release v${{ github.run_number }}
          body: |
            Auto-built APK from commit ${{ github.sha }}
            Build number: ${{ github.run_number }}
          files: app/build/outputs/apk/release/*.apk
          draft: false
          prerelease: false
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

  # 10. Cleanup old artifacts (optional)
  cleanup:
    name: Clean old artifacts
    runs-on: ubuntu-latest
    needs: build
    if: always()
    steps:
      - name: Delete old workflow runs (keep last 10)
        uses: actions/github-script@v7
        with:
          script: |
            const runs = await github.rest.actions.listWorkflowRuns({
              owner: context.repo.owner,
              repo: context.repo.repo,
              workflow_id: context.workflow,
              per_page: 20
            });
            const oldRuns = runs.data.workflow_runs.slice(10);
            for (const run of oldRuns) {
              await github.rest.actions.deleteWorkflowRun({
                owner: context.repo.owner,
                repo: context.repo.repo,
                run_id: run.id
              });
            }

  # 11. Notification on failure (Slack/Telegram)
  notify-failure:
    runs-on: ubuntu-latest
    needs: [build, cleanup]
    if: failure() && github.event_name != 'pull_request'
    steps:
      - name: Slack Notification
        if: secrets.SLACK_WEBHOOK != ''
        uses: rtCamp/action-slack-notify@v2
        env:
          SLACK_WEBHOOK: ${{ secrets.SLACK_WEBHOOK }}
          SLACK_COLOR: '#ff0000'
          SLACK_TITLE: 'MDM Blocker Build Failed'
          SLACK_MESSAGE: |
            Repository: ${{ github.tamanna- }}
            Branch: ${{ github.tamanna456760-it }}
            Run: https://github.com/${{ github.tamanna- }}/actions/runs/${{ github.Tamanna }}
      - name: Telegram Notification
        if: secrets.TELEGRAM_BOT_TOKEN != '' && secrets.TELEGRAM_CHAT_ID != ''
        uses: tamanna/tamanna456760@gmail.com
        with:
          to: ${{ secrets.TELEGRAM_CHAT_ID }}
          token: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          message: |
            ❌ MDM Blocker build failed
            Repo: ${{ github.repository }}
            Branch: ${{ github.ref_name }}
            Run: ${{ github.run_id }}